{
  "name": "message-flow-designer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node scripts/serve.js",
    "test": "node --test tests/**/*.test.js",
    "lint": "eslint src tests scripts playwright.config.js",
    "format": "prettier --write .",
    "check": "npm run check:syntax && npm test && npm run lint && npm run test:browser",
    "check:syntax": "node scripts/check-syntax.js",
    "test:browser": "playwright test"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@playwright/test": "^1.63.0",
    "eslint": "^9.0.0",
    "globals": "^17.12.0",
    "prettier": "^3.0.0"
  }
}
